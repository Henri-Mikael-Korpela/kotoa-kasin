build/

# Bundles, generated by kasin-jsbundle from js/ and kasin-cssbundle from css/
# (see js/bundles.txt and css/bundles.txt).
public/js/
public/css/

# HTML pages, generated by kasin-htmlgen from templates/ (see docs/html-templating.md).
public/*.html
public/hallinta/*.html

# Admin password hashes (KASIN_ADMIN_PASSWORD_HASH): .env for local development,
# deploy/secrets.env for Azure. A salted hash is still guessable offline, so it
# stays out of version control.
.env
deploy/secrets.env

# Personal deployment settings (AZURE_SUBSCRIPTION, AZURE_TENANT) that override
# deploy/config.env. They identify your Azure account, so they stay out of
# version control.
deploy/config.local.env

# Production database backups made by deploy/bin/backup-db-prod.
backups/
