#!/usr/bin/env bash
#
# Deploys kotoa-kasin to Azure Container Apps.
#
# Run inside the deployment tooling container:
#   docker exec -it kotoa-kasin-deploy deploy
#
# Safe to run repeatedly. The first run creates everything (resource group,
# container registry, storage for the database, Container Apps environment and
# the app); later runs only build a new image and roll the app over to it.
#
# Settings: deploy/config.env, overridden by deploy/config.local.env.

set -euo pipefail

REPO_DIR=${REPO_DIR:-/workspace}
CONFIG_FILE="$REPO_DIR/deploy/config.env"
LOCAL_CONFIG_FILE="$REPO_DIR/deploy/config.local.env"

usage() {
    cat <<'EOF'
usage: deploy [--help]

Builds the server image in Azure and deploys it to Azure Container Apps.
Signs in to Azure first if needed (device code: open the shown link on any device).
Settings are read from deploy/config.env, then from deploy/config.local.env (not
committed) if it exists, so a value in the local file wins.

The admin password hash is read from KASIN_ADMIN_PASSWORD_HASH in
deploy/secrets.env (or the environment) and stored as a Container Apps secret.
Make it with kasin-passwd. It is needed on the first deployment; later ones keep
the stored secret unless a new hash is given.
EOF
}

case "${1:-}" in
    "")
        ;;
    -h | --help)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 64
        ;;
esac

step() {
    printf '\n==> %s\n' "$*"
}

# shellcheck source-path=SCRIPTDIR source=../config.env
. "$CONFIG_FILE"
if [ -f "$LOCAL_CONFIG_FILE" ]; then
    # shellcheck source=/dev/null
    . "$LOCAL_CONFIG_FILE"
fi

SECRETS_FILE="$REPO_DIR/deploy/secrets.env"
HASH_PATTERN='^pbkdf2-sha256:[0-9]+:[0-9a-f]{32}:[0-9a-f]{64}$'

# The admin password hash: from the environment, else from deploy/secrets.env
# (never committed). The file is read, not sourced, so nothing in it runs. Bytes
# other than printable ASCII are dropped first, so a file saved as UTF-16 (the
# default of ">" in Windows PowerShell 5.1), with a byte order mark or with CRLF
# line ends still reads correctly.
ADMIN_PASSWORD_HASH=${KASIN_ADMIN_PASSWORD_HASH:-}
if [ -z "$ADMIN_PASSWORD_HASH" ] && [ -f "$SECRETS_FILE" ]; then
    ADMIN_PASSWORD_HASH=$(LC_ALL=C tr -cd '[:print:]\n' < "$SECRETS_FILE" |
        sed -n 's/^[[:space:]]*KASIN_ADMIN_PASSWORD_HASH=//p' | tail -n 1 | tr -d '[:space:]"'"'")
fi
if [ -n "$ADMIN_PASSWORD_HASH" ] && ! [[ "$ADMIN_PASSWORD_HASH" =~ $HASH_PATTERN ]]; then
    echo "error: KASIN_ADMIN_PASSWORD_HASH is not a hash made by kasin-passwd." >&2
    exit 1
fi

RG=$AZURE_RESOURCE_GROUP
LOCATION=$AZURE_LOCATION
ENV_NAME=$AZURE_CONTAINERAPP_ENV
APP_NAME=$AZURE_CONTAINERAPP_NAME
SHARE=$AZURE_FILE_SHARE
ENV_STORAGE=data  # Name of the share's link inside the Container Apps environment.

# Sign in.
#
# A Microsoft account can belong to several directories (tenants), and an az
# session works in only one of them. AZURE_TENANT picks the directory that holds
# the subscription.

login() {
    local args=(--use-device-code --output none)
    if [ -n "${AZURE_TENANT:-}" ]; then
        args+=(--tenant "$AZURE_TENANT")
    fi
    az login "${args[@]}"
}

# Selects AZURE_SUBSCRIPTION, if one is configured. Fails quietly when it is not
# visible to the current sign-in.
select_subscription() {
    [ -z "${AZURE_SUBSCRIPTION:-}" ] || az account set --subscription "$AZURE_SUBSCRIPTION" 2>/dev/null
}

if ! az account show --output none 2>/dev/null; then
    step "Signing in to Azure"
    login
fi
if ! select_subscription; then
    if [ -n "${AZURE_TENANT:-}" ]; then
        step "Subscription not found in the current sign-in; signing in to $AZURE_TENANT"
        login
    fi
    if ! select_subscription; then
        {
            echo "error: subscription '$AZURE_SUBSCRIPTION' is not visible to the current sign-in."
            echo "Subscriptions it can see:"
            az account list --all --query '[].{name:name, id:id, tenant:tenantDefaultDomain}' --output table
            echo
            echo "A subscription in another directory needs AZURE_TENANT in deploy/config.local.env"
            echo "(the directory's domain, like example.onmicrosoft.com, or its tenant id)."
        } >&2
        exit 1
    fi
fi
SUBSCRIPTION_ID=$(az account show --query id --output tsv)
echo "Subscription: $(az account show --query name --output tsv) ($SUBSCRIPTION_ID)"

SUFFIX=$(printf '%s' "$SUBSCRIPTION_ID" | tr -d '-' | cut -c1-8)
ACR_NAME=${AZURE_ACR_NAME:-kotoakasin$SUFFIX}
STORAGE_ACCOUNT=${AZURE_STORAGE_ACCOUNT:-kotoakasin$SUFFIX}

step "Preparing the Azure CLI and resource providers"
az extension add --name containerapp --upgrade --only-show-errors
for namespace in Microsoft.App Microsoft.ContainerRegistry Microsoft.Storage; do
    state=$(az provider show --namespace "$namespace" --query registrationState --output tsv 2>/dev/null || true)
    if [ "$state" != "Registered" ]; then
        echo "Registering $namespace (first deployment only, can take a few minutes)"
        az provider register --namespace "$namespace" --wait
    fi
done

# Without a hash the app must already hold one, or nobody could log in.
ADMIN_SECRET=admin-password-hash
if [ -z "$ADMIN_PASSWORD_HASH" ]; then
    stored=0
    if az containerapp show --name "$APP_NAME" --resource-group "$RG" --output none 2>/dev/null; then
        stored=$(az containerapp secret list --name "$APP_NAME" --resource-group "$RG" \
            --query "length([?name=='$ADMIN_SECRET'])" --output tsv)
    fi
    if [ "$stored" != "1" ]; then
        {
            echo "error: no admin password hash. Make one in the dev container:"
            echo "  docker compose -f dev.docker-compose.yml exec httpd /build/kasin-passwd"
            echo "and put the printed KASIN_ADMIN_PASSWORD_HASH=... line in deploy/secrets.env."
            echo "Use a different, strong password for the live site; kasin-passwd -g makes one."
        } >&2
        exit 1
    fi
    echo "Admin password: keeping the hash already stored in Azure."
fi

step "Resource group $RG in $LOCATION"
az group create --name "$RG" --location "$LOCATION" --output none

# Container registry, and the image built from the repository in Azure.

if ! az acr show --name "$ACR_NAME" --resource-group "$RG" --output none 2>/dev/null; then
    step "Creating container registry $ACR_NAME"
    az acr create --name "$ACR_NAME" --resource-group "$RG" --location "$LOCATION" \
        --sku Basic --admin-enabled true --output none
fi

TAG=$(date -u +%Y%m%d-%H%M%S)
IMAGE="$ACR_NAME.azurecr.io/$IMAGE_NAME:$TAG"
step "Building $IMAGE in Azure"
az acr build --registry "$ACR_NAME" --image "$IMAGE_NAME:$TAG" \
    --file "$REPO_DIR/Dockerfile" "$REPO_DIR"

# Storage for the SQLite database.

if ! az storage account show --name "$STORAGE_ACCOUNT" --resource-group "$RG" --output none 2>/dev/null; then
    step "Creating storage account $STORAGE_ACCOUNT"
    az storage account create --name "$STORAGE_ACCOUNT" --resource-group "$RG" \
        --location "$LOCATION" --sku Standard_LRS --kind StorageV2 \
        --min-tls-version TLS1_2 --allow-blob-public-access false --output none
fi
share_exists=$(az storage share-rm exists --storage-account "$STORAGE_ACCOUNT" \
    --resource-group "$RG" --name "$SHARE" --query exists --output tsv)
if [ "$share_exists" != "true" ]; then
    step "Creating file share $SHARE"
    az storage share-rm create --storage-account "$STORAGE_ACCOUNT" --resource-group "$RG" \
        --name "$SHARE" --quota 1 --output none
fi
STORAGE_KEY=$(az storage account keys list --account-name "$STORAGE_ACCOUNT" \
    --resource-group "$RG" --query '[0].value' --output tsv)

# Container Apps environment, with the share attached.

if ! az containerapp env show --name "$ENV_NAME" --resource-group "$RG" --output none 2>/dev/null; then
    step "Creating Container Apps environment $ENV_NAME (takes a few minutes)"
    # Console logs stay available live with `az containerapp logs show`;
    # skipping Log Analytics avoids its cost.
    az containerapp env create --name "$ENV_NAME" --resource-group "$RG" \
        --location "$LOCATION" --logs-destination none --output none
fi
az containerapp env storage set --name "$ENV_NAME" --resource-group "$RG" \
    --storage-name "$ENV_STORAGE" --azure-file-account-name "$STORAGE_ACCOUNT" \
    --azure-file-account-key "$STORAGE_KEY" --azure-file-share-name "$SHARE" \
    --access-mode ReadWrite --output none

# The app itself.

if az containerapp show --name "$APP_NAME" --resource-group "$RG" --output none 2>/dev/null; then
    # The ingress adds the client's address to X-Forwarded-For; see KASIN_TRUST_PROXY.
    env_vars=("KASIN_TRUST_PROXY=1")
    if [ -n "$ADMIN_PASSWORD_HASH" ]; then
        step "Storing the admin password hash as secret $ADMIN_SECRET"
        az containerapp secret set --name "$APP_NAME" --resource-group "$RG" \
            --secrets "$ADMIN_SECRET=$ADMIN_PASSWORD_HASH" --output none
        env_vars+=("KASIN_ADMIN_PASSWORD_HASH=secretref:$ADMIN_SECRET")
    fi
    step "Rolling $APP_NAME over to the new image"
    az containerapp update --name "$APP_NAME" --resource-group "$RG" --image "$IMAGE" \
        --set-env-vars "${env_vars[@]}" --output none
else
    step "Creating container app $APP_NAME"
    ENV_ID=$(az containerapp env show --name "$ENV_NAME" --resource-group "$RG" --query id --output tsv)
    ACR_PASSWORD=$(az acr credential show --name "$ACR_NAME" --query 'passwords[0].value' --output tsv)
    # Generated once; stored as an app secret so logins survive restarts and deploys.
    JWT_SECRET=$(head -c 32 /dev/urandom | base64 | tr -d '\n')

    APP_YAML=$(mktemp)
    trap 'rm -f "$APP_YAML"' EXIT
    chmod 600 "$APP_YAML"
    # Volume mounts can only be configured through YAML. One replica at most:
    # SQLite allows a single writer, and the database lives on a file share.
    # Zero replicas when idle, so an unused site costs next to nothing.
    cat > "$APP_YAML" <<EOF
location: $LOCATION
properties:
  managedEnvironmentId: $ENV_ID
  configuration:
    activeRevisionsMode: Single
    ingress:
      external: true
      targetPort: 8080
      transport: auto
      allowInsecure: false
    registries:
      - server: $ACR_NAME.azurecr.io
        username: $ACR_NAME
        passwordSecretRef: registry-password
    secrets:
      - name: registry-password
        value: "$ACR_PASSWORD"
      - name: jwt-secret
        value: "$JWT_SECRET"
      - name: $ADMIN_SECRET
        value: "$ADMIN_PASSWORD_HASH"
  template:
    containers:
      - name: $APP_NAME
        image: $IMAGE
        resources:
          cpu: 0.25
          memory: 0.5Gi
        env:
          - name: KASIN_JWT_SECRET
            secretRef: jwt-secret
          - name: KASIN_ADMIN_PASSWORD_HASH
            secretRef: $ADMIN_SECRET
          # The ingress adds the client's address to X-Forwarded-For.
          - name: KASIN_TRUST_PROXY
            value: "1"
        volumeMounts:
          - volumeName: data
            mountPath: /data
    scale:
      minReplicas: 0
      maxReplicas: 1
    volumes:
      - name: data
        storageType: AzureFile
        storageName: $ENV_STORAGE
EOF
    az containerapp create --name "$APP_NAME" --resource-group "$RG" --yaml "$APP_YAML" --output none
fi

FQDN=$(az containerapp show --name "$APP_NAME" --resource-group "$RG" \
    --query properties.configuration.ingress.fqdn --output tsv)

step "Checking https://$FQDN/health"
# The app may be scaled to zero; the first request starts it.
if curl --silent --fail --retry 10 --retry-delay 6 --retry-all-errors --max-time 30 \
    "https://$FQDN/health" > /dev/null; then
    echo "Healthy."
else
    echo "No healthy answer yet. Inspect with:"
    echo "  az containerapp logs show --name $APP_NAME --resource-group $RG --follow"
fi

step "Deployed $IMAGE"
echo "Site:  https://$FQDN"
echo "Admin: https://$FQDN/hallinta"
