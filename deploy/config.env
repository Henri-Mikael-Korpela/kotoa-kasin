# Settings for deploy/bin/deploy. Plain KEY=value lines, read by bash.
#
# This file is committed. Settings that identify your Azure account
# (AZURE_SUBSCRIPTION, AZURE_TENANT) go in deploy/config.local.env instead, which
# is read after this file and is not in version control.

# Subscription name or id. Empty: the subscription `az login` selected.
AZURE_SUBSCRIPTION=

# Directory (tenant) that holds the subscription: its domain, such as
# example.onmicrosoft.com, or its id. One Microsoft account can belong to several
# directories, and `az login` signs in to only one of them. Set this when
# `deploy` cannot find AZURE_SUBSCRIPTION. Empty: the account's default directory.
AZURE_TENANT=

# Azure region for every resource.
AZURE_LOCATION=swedencentral

AZURE_RESOURCE_GROUP=kotoa-kasin
AZURE_CONTAINERAPP_ENV=kotoa-kasin-env
AZURE_CONTAINERAPP_NAME=kotoa-kasin
IMAGE_NAME=kotoa-kasin

# Globally unique names. Empty: "kotoakasin" plus 8 characters of the
# subscription id, which is stable for your subscription and unlikely to clash.
# Registry: 5-50 letters and digits. Storage account: 3-24 lowercase letters and digits.
AZURE_ACR_NAME=
AZURE_STORAGE_ACCOUNT=

# Azure Files share that holds the SQLite database, mounted at /data.
AZURE_FILE_SHARE=kotoa-data
# Size limit of that share in GiB. The gallery shows it as the total storage and
# refuses uploads that do not fit. Raising it later applies on the next deploy.
AZURE_FILE_SHARE_QUOTA_GB=1

# Daytime window in which one replica is kept running, so that visitors do not wait
# for a cold start. Outside it the app scales to zero when idle (only the first
# visitor then waits). The times are cron expressions (minute hour day month
# weekday) in the time zone below, an IANA name, so daylight saving time is followed.
# Applied on every deploy.
AZURE_DAYTIME_TIMEZONE=Europe/Helsinki
AZURE_DAYTIME_START="0 7 * * *"
AZURE_DAYTIME_END="0 23 * * *"
